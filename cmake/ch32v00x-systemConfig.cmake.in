@PACKAGE_INIT@

# Ensure dependencies are available before loading the targets they reference
include(CMakeFindDependencyMacro)

# The package provides the headers only. The library sources are not installed,
# so this target has no objects: add the sources with add_subdirectory().
if (NOT TARGET ch32v00x-system)
    add_library(ch32v00x-system INTERFACE IMPORTED)
    set_target_properties(ch32v00x-system PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include")
endif ()

# Optional: ensure all requested components are found (if you define any)
check_required_components(ch32v00x-system)